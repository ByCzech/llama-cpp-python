#!/usr/bin/make -f

CORE_PACKAGE := python3-llama-cpp-python-core
CPU_PACKAGE  := python3-llama-cpp-python-backend-cpu
VULKAN_PACKAGE := python3-llama-cpp-python-backend-vulkan
CUDA124_PACKAGE := python3-llama-cpp-python-backend-cuda12.4
CUDA129_PACKAGE := python3-llama-cpp-python-backend-cuda12.9
CUDA133_PACKAGE := python3-llama-cpp-python-backend-cuda13.3
ROCM714_PACKAGE := python3-llama-cpp-python-backend-rocm7.14
SYCL_PACKAGE := python3-llama-cpp-python-backend-sycl
PYLIB_DIR    := usr/lib/python3/dist-packages/llama_cpp/lib
CUDA124_BUILD_DIR := build-cuda12.4
CUDA129_BUILD_DIR := build-cuda12.9
CUDA133_BUILD_DIR := build-cuda13.3
ROCM714_BUILD_DIR := build-rocm7.14
SYCL_BUILD_DIR := build-sycl
CUDA124_BACKEND_DIR := $(PYLIB_DIR)/backends/cuda12.4
CUDA129_BACKEND_DIR := $(PYLIB_DIR)/backends/cuda12.9
CUDA133_BACKEND_DIR := $(PYLIB_DIR)/backends/cuda13.3
ROCM714_BACKEND_DIR := $(PYLIB_DIR)/backends/rocm7.14
SYCL_BACKEND_DIR := $(PYLIB_DIR)/backends/sycl
CUDA129_ROOT := /usr/local/cuda-12.9
CUDA129_SHADOW := $(CURDIR)/debian/.cuda-12.9-shadow
CUDA133_ROOT := /usr/local/cuda-13.3
ROCM714_ROOT := /opt/rocm/core-7.14
ROCM714_CMAKE_DIR := $(ROCM714_ROOT)/lib/cmake
ROCM714_INCLUDE_DIR := $(ROCM714_ROOT)/include
ROCM714_LLVM_DIR := $(ROCM714_ROOT)/lib/llvm
ROCM714_DEVICE_LIB_DIR := $(ROCM714_ROOT)/amdgcn/bitcode
ONEAPI_ROOT := /opt/intel/oneapi
ONEAPI_COMPILER_ROOT := $(ONEAPI_ROOT)/compiler/latest
ONEAPI_MKL_ROOT := $(ONEAPI_ROOT)/mkl/latest
ONEAPI_DNNL_ROOT := $(ONEAPI_ROOT)/dnnl/latest
ONEAPI_TBB_ROOT := $(ONEAPI_ROOT)/tbb/latest
GNU_GCC_INSTALL_DIR := $(shell dirname "$$(g++ -print-file-name=crtbeginS.o)")
ONEAPI_LD_LIBRARY_PATH := $(ONEAPI_COMPILER_ROOT)/lib:$(ONEAPI_MKL_ROOT)/lib:$(ONEAPI_DNNL_ROOT)/lib:$(ONEAPI_TBB_ROOT)/lib
ONEAPI_CMAKE_PREFIX_PATH := $(ONEAPI_COMPILER_ROOT):$(ONEAPI_MKL_ROOT):$(ONEAPI_DNNL_ROOT):$(ONEAPI_TBB_ROOT)
# ROCm 7.14 targets backed by device-specific packages in AMD's stable
# Debian 13 repository.  gfx900/gfx906/gfx90c are TheRock development
# targets but 7.14 does not ship matching Debian device/BLAS packages.
ROCM714_TARGETS := gfx908;gfx90a;gfx942;gfx950;gfx1010;gfx1011;gfx1012;gfx1030;gfx1031;gfx1032;gfx1033;gfx1034;gfx1035;gfx1036;gfx1100;gfx1101;gfx1102;gfx1103;gfx1150;gfx1151;gfx1152;gfx1153;gfx1200;gfx1201
DEB_VERSION  := $(shell dpkg-parsechangelog -SVersion)
DEB_HOST_MULTIARCH := $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)
DEB_SYSTEM_LIBDIR := /usr/lib/$(DEB_HOST_MULTIARCH)

.PHONY: clean
clean:
	# Never invoke dh_auto_clean/pybuild here. A failed pip/scikit-build build
	# may leave partially configured CMake trees, and asking the build system
	# to clean them can configure or build again.
	dh_clean
	rm -rf .pybuild build _skbuild dist wheelhouse $(CUDA124_BUILD_DIR) \
		$(CUDA129_BUILD_DIR) $(CUDA133_BUILD_DIR) $(ROCM714_BUILD_DIR) $(SYCL_BUILD_DIR) $(CUDA129_SHADOW) \
		.scikit-build .pytest_cache .mypy_cache .ruff_cache \
		llama_cpp_python.egg-info pip-wheel-metadata
	find llama_cpp -type d -name '__pycache__' -prune -exec rm -rf {} + 2>/dev/null || true
	find llama_cpp/lib -maxdepth 1 -type f \
		\( -name '*.so' -o -name '*.so.*' -o -name '*.dylib' \
		-o -name '*.dll' -o -name '*.a' -o -name '*.lib' \) \
		-delete 2>/dev/null || true

%:
	dh $@ --with python3 --buildsystem=pybuild

# The actual CMake configure/build/install is driven by scikit-build-core below.
# Avoid creating a second, unused .pybuild CMake tree first.
override_dh_auto_configure:
	:

override_dh_auto_build:
	:

override_dh_auto_test:
	:

override_dh_auto_install:
	rm -rf debian/$(CORE_PACKAGE) debian/$(CPU_PACKAGE) debian/$(VULKAN_PACKAGE) \
		debian/$(CUDA124_PACKAGE) debian/$(CUDA129_PACKAGE) debian/$(CUDA133_PACKAGE) \
		debian/$(ROCM714_PACKAGE) debian/$(SYCL_PACKAGE) \
		$(CUDA124_BUILD_DIR) $(CUDA129_BUILD_DIR) $(CUDA133_BUILD_DIR) $(ROCM714_BUILD_DIR) $(SYCL_BUILD_DIR)

	CMAKE_ARGS="-DLLAMA_CPP_PYTHON_DEBIAN_BUILD=ON \
		-DGGML_NATIVE=OFF \
		-DGGML_BACKEND_DL=ON \
		-DGGML_CPU_ALL_VARIANTS=ON \
		-DGGML_VULKAN=ON \
		-DGGML_OPENMP=ON \
		-DGGML_BLAS=ON \
		-DGGML_BLAS_VENDOR=OpenBLAS" \
	DEB_PYTHON_INSTALL_LAYOUT=deb \
	python3 -m pip install . \
		--no-deps \
		--no-build-isolation \
		--prefix=/usr \
		--ignore-installed \
		--root=$(CURDIR)/debian/$(CORE_PACKAGE)

	# Split dynamically loadable CPU/BLAS backends out of the common runtime.
	mkdir -p debian/$(CPU_PACKAGE)/$(PYLIB_DIR)
	find debian/$(CORE_PACKAGE)/$(PYLIB_DIR) -maxdepth 1 \
		\( -name 'libggml-cpu-*.so*' -o -name 'libggml-blas.so*' \) \
		-exec mv -t debian/$(CPU_PACKAGE)/$(PYLIB_DIR) {} +

	# Split the dynamically loadable Vulkan backend into its own package.
	mkdir -p debian/$(VULKAN_PACKAGE)/$(PYLIB_DIR)
	find debian/$(CORE_PACKAGE)/$(PYLIB_DIR) -maxdepth 1 \
		-name 'libggml-vulkan.so*' \
		-exec mv -t debian/$(VULKAN_PACKAGE)/$(PYLIB_DIR) {} +

	# Build the CUDA 12.4 backend separately from the common runtime.
	# This keeps CUDA toolkit selection isolated so CUDA 12.9/13 backends can
	# later be built from the same source tree and co-installed.
	/usr/bin/nvcc --version | grep -Eq 'release 12\.4([, ])'
	cmake -S vendor/llama.cpp -B $(CUDA124_BUILD_DIR) -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_CUDA_COMPILER=/usr/bin/nvcc \
		-DBUILD_SHARED_LIBS=ON \
		-DLLAMA_BUILD_COMMON=OFF \
		-DLLAMA_BUILD_TESTS=OFF \
		-DLLAMA_BUILD_TOOLS=OFF \
		-DLLAMA_BUILD_EXAMPLES=OFF \
		-DLLAMA_BUILD_SERVER=OFF \
		-DLLAMA_BUILD_APP=OFF \
		-DLLAMA_BUILD_UI=OFF \
		-DGGML_NATIVE=OFF \
		-DGGML_BACKEND_DL=ON \
		-DGGML_CPU=OFF \
		-DGGML_BLAS=OFF \
		-DGGML_CUDA=ON \
		-DGGML_CUDA_GRAPHS=ON \
		-DGGML_CUDA_NCCL=OFF \
		-DGGML_OPENMP=ON \
		-DGGML_BUILD_TESTS=OFF \
		-DGGML_BUILD_EXAMPLES=OFF
	cmake --build $(CUDA124_BUILD_DIR) --target ggml-cuda

	# Keep the real backend in a versioned private directory.  The public
	# libggml-cuda.so path is managed by update-alternatives.
	mkdir -p debian/$(CUDA124_PACKAGE)/$(CUDA124_BACKEND_DIR)
	cp -a $(CUDA124_BUILD_DIR)/bin/libggml-cuda.so* \
		debian/$(CUDA124_PACKAGE)/$(CUDA124_BACKEND_DIR)/
	find debian/$(CUDA124_PACKAGE)/$(CUDA124_BACKEND_DIR) -maxdepth 1 \
		-type f -name 'libggml-cuda.so*' \
		-exec patchelf --set-rpath '$$ORIGIN/../..' {} +

	# Build CUDA 12.9 from a private shadow of NVIDIA's versioned toolkit.
	# CUDA 12.9 headers conflict with glibc 2.41's noexcept declarations for
	# sinpi/cospi.  Never modify files owned by NVIDIA packages in /usr/local:
	# create a symlink farm, materialize only nvcc and the affected header, and
	# patch that private copy for this build.
	$(CUDA129_ROOT)/bin/nvcc --version | grep -Eq 'release 12\.9([, ])'
	rm -rf $(CUDA129_SHADOW)
	cp -as $(CUDA129_ROOT)/. $(CUDA129_SHADOW)/
	rm -f $(CUDA129_SHADOW)/bin/nvcc
	cp -a $(CUDA129_ROOT)/bin/nvcc $(CUDA129_SHADOW)/bin/nvcc
	rm -f $(CUDA129_SHADOW)/targets/x86_64-linux/include/crt/math_functions.h
	cp -a $(CUDA129_ROOT)/targets/x86_64-linux/include/crt/math_functions.h \
		$(CUDA129_SHADOW)/targets/x86_64-linux/include/crt/math_functions.h
	python3 debian/cuda12.9-glibc2.41.py \
		$(CUDA129_SHADOW)/targets/x86_64-linux/include/crt/math_functions.h
	$(CUDA129_SHADOW)/bin/nvcc --version | grep -Eq 'release 12\.9([, ])'
	cmake -S vendor/llama.cpp -B $(CUDA129_BUILD_DIR) -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_CUDA_COMPILER=$(CUDA129_SHADOW)/bin/nvcc \
		-DCUDAToolkit_ROOT=$(CUDA129_SHADOW) \
		-DBUILD_SHARED_LIBS=ON \
		-DLLAMA_BUILD_COMMON=OFF \
		-DLLAMA_BUILD_TESTS=OFF \
		-DLLAMA_BUILD_TOOLS=OFF \
		-DLLAMA_BUILD_EXAMPLES=OFF \
		-DLLAMA_BUILD_SERVER=OFF \
		-DLLAMA_BUILD_APP=OFF \
		-DLLAMA_BUILD_UI=OFF \
		-DGGML_NATIVE=OFF \
		-DGGML_BACKEND_DL=ON \
		-DGGML_CPU=OFF \
		-DGGML_BLAS=OFF \
		-DGGML_CUDA=ON \
		-DGGML_CUDA_GRAPHS=ON \
		-DGGML_CUDA_NCCL=OFF \
		-DGGML_OPENMP=ON \
		-DGGML_BUILD_TESTS=OFF \
		-DGGML_BUILD_EXAMPLES=OFF
	cmake --build $(CUDA129_BUILD_DIR) --target ggml-cuda
	mkdir -p debian/$(CUDA129_PACKAGE)/$(CUDA129_BACKEND_DIR)
	cp -a $(CUDA129_BUILD_DIR)/bin/libggml-cuda.so* \
		debian/$(CUDA129_PACKAGE)/$(CUDA129_BACKEND_DIR)/
	find debian/$(CUDA129_PACKAGE)/$(CUDA129_BACKEND_DIR) -maxdepth 1 \
		-type f -name 'libggml-cuda.so*' \
		-exec patchelf --set-rpath '$$ORIGIN/../..' {} +

	# Build CUDA 13.3 independently for Turing and newer NVIDIA GPUs.
	$(CUDA133_ROOT)/bin/nvcc --version | grep -Eq 'release 13\.3([, ])'
	cmake -S vendor/llama.cpp -B $(CUDA133_BUILD_DIR) -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_CUDA_COMPILER=$(CUDA133_ROOT)/bin/nvcc \
		-DCUDAToolkit_ROOT=$(CUDA133_ROOT) \
		-DBUILD_SHARED_LIBS=ON \
		-DLLAMA_BUILD_COMMON=OFF \
		-DLLAMA_BUILD_TESTS=OFF \
		-DLLAMA_BUILD_TOOLS=OFF \
		-DLLAMA_BUILD_EXAMPLES=OFF \
		-DLLAMA_BUILD_SERVER=OFF \
		-DLLAMA_BUILD_APP=OFF \
		-DLLAMA_BUILD_UI=OFF \
		-DGGML_NATIVE=OFF \
		-DGGML_BACKEND_DL=ON \
		-DGGML_CPU=OFF \
		-DGGML_BLAS=OFF \
		-DGGML_CUDA=ON \
		-DGGML_CUDA_GRAPHS=ON \
		-DGGML_CUDA_NCCL=OFF \
		-DGGML_OPENMP=ON \
		-DGGML_BUILD_TESTS=OFF \
		-DGGML_BUILD_EXAMPLES=OFF
	cmake --build $(CUDA133_BUILD_DIR) --target ggml-cuda
	mkdir -p debian/$(CUDA133_PACKAGE)/$(CUDA133_BACKEND_DIR)
	cp -a $(CUDA133_BUILD_DIR)/bin/libggml-cuda.so* \
		debian/$(CUDA133_PACKAGE)/$(CUDA133_BACKEND_DIR)/
	find debian/$(CUDA133_PACKAGE)/$(CUDA133_BACKEND_DIR) -maxdepth 1 \
		-type f -name 'libggml-cuda.so*' \
		-exec patchelf --set-rpath '$$ORIGIN/../..' {} +

	# Build the ROCm 7.14 HIP backend independently.  The new TheRock SDK lives
	# under a versioned /opt/rocm/core-X.Y prefix.  Debian's legacy ROCm 5.7
	# development headers in /usr/include/hip take precedence over TheRock's
	# compiler-provided -idirafter include path, so they must not be installed
	# while this source package is built (also declared via Build-Conflicts).
	test -x $(ROCM714_ROOT)/bin/hipcc
	test -x $(ROCM714_LLVM_DIR)/bin/clang++
	test -f $(ROCM714_INCLUDE_DIR)/hip/hip_fp16.h
	test ! -e /usr/include/hip/hip_fp16.h || { \
		echo "legacy Debian HIP headers found in /usr/include/hip; remove libamdhip64-dev (or run apt-get build-dep . to satisfy Build-Conflicts)" >&2; \
		exit 1; \
	}
	test -d $(ROCM714_DEVICE_LIB_DIR)
	test -f $(ROCM714_CMAKE_DIR)/hip/hip-config.cmake
	test -f $(ROCM714_CMAKE_DIR)/hip-lang/hip-lang-config.cmake
	test -f $(ROCM714_CMAKE_DIR)/hipblas/hipblas-config.cmake
	test -f $(ROCM714_CMAKE_DIR)/rocblas/rocblas-config.cmake
	$(ROCM714_ROOT)/bin/hipconfig --version | grep -Eq '7\.14'

	# Cheap compiler smoke test before the expensive multi-architecture build.
	mkdir -p $(ROCM714_BUILD_DIR)
	printf '%s\n' '#include <hip/hip_fp16.h>' '__global__ void rocm_path_probe() {}' \
		> $(ROCM714_BUILD_DIR)/hip-path-probe.hip
	HIP_PLATFORM=amd HIP_PATH=$(ROCM714_ROOT) ROCM_PATH=$(ROCM714_ROOT) \
	HIP_CLANG_PATH=$(ROCM714_LLVM_DIR)/bin \
	HIP_INCLUDE_PATH=$(ROCM714_INCLUDE_DIR) \
	HIP_DEVICE_LIB_PATH=$(ROCM714_DEVICE_LIB_DIR) DEVICE_LIB_PATH=$(ROCM714_DEVICE_LIB_DIR) \
	$(ROCM714_LLVM_DIR)/bin/clang++ \
		--offload-arch=gfx1010 \
		-x hip -c $(ROCM714_BUILD_DIR)/hip-path-probe.hip \
		-o $(ROCM714_BUILD_DIR)/hip-path-probe.o
	rm -f $(ROCM714_BUILD_DIR)/hip-path-probe.hip $(ROCM714_BUILD_DIR)/hip-path-probe.o

	HIP_PLATFORM=amd HIP_PATH=$(ROCM714_ROOT) ROCM_PATH=$(ROCM714_ROOT) \
	HIP_CLANG_PATH=$(ROCM714_LLVM_DIR)/bin \
	HIP_INCLUDE_PATH=$(ROCM714_INCLUDE_DIR) \
	HIP_DEVICE_LIB_PATH=$(ROCM714_DEVICE_LIB_DIR) DEVICE_LIB_PATH=$(ROCM714_DEVICE_LIB_DIR) \
	PATH=$(ROCM714_ROOT)/bin:$(ROCM714_LLVM_DIR)/bin:$$PATH \
	cmake -S vendor/llama.cpp -B $(ROCM714_BUILD_DIR) -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_HIP_COMPILER=$(ROCM714_LLVM_DIR)/bin/clang++ \
		-DCMAKE_HIP_COMPILER_ROCM_ROOT=$(ROCM714_ROOT) \
		-DCMAKE_PREFIX_PATH=$(ROCM714_CMAKE_DIR) \
		-Dhip_DIR=$(ROCM714_CMAKE_DIR)/hip \
		-Dhipblas_DIR=$(ROCM714_CMAKE_DIR)/hipblas \
		-Drocblas_DIR=$(ROCM714_CMAKE_DIR)/rocblas \
		-DHIP_PLATFORM=amd \
		-DCMAKE_HIP_ARCHITECTURES="$(ROCM714_TARGETS)" \
		-DBUILD_SHARED_LIBS=ON \
		-DLLAMA_BUILD_COMMON=OFF \
		-DLLAMA_BUILD_TESTS=OFF \
		-DLLAMA_BUILD_TOOLS=OFF \
		-DLLAMA_BUILD_EXAMPLES=OFF \
		-DLLAMA_BUILD_SERVER=OFF \
		-DLLAMA_BUILD_APP=OFF \
		-DLLAMA_BUILD_UI=OFF \
		-DGGML_NATIVE=OFF \
		-DGGML_BACKEND_DL=ON \
		-DGGML_CPU=OFF \
		-DGGML_BLAS=OFF \
		-DGGML_HIP=ON \
		-DGGML_HIP_GRAPHS=ON \
		-DGGML_HIP_RCCL=OFF \
		-DGGML_HIP_NO_VMM=ON \
		-DGGML_OPENMP=ON \
		-DGGML_BUILD_TESTS=OFF \
		-DGGML_BUILD_EXAMPLES=OFF
	# Fail before the expensive compile if CMake resolved any HIP package from
	# Debian's legacy ROCm in /usr instead of the pinned ROCm 7.14 SDK.
	grep -Fxq 'hip_DIR:UNINITIALIZED=$(ROCM714_CMAKE_DIR)/hip' $(ROCM714_BUILD_DIR)/CMakeCache.txt || \
		grep -Fxq 'hip_DIR:PATH=$(ROCM714_CMAKE_DIR)/hip' $(ROCM714_BUILD_DIR)/CMakeCache.txt
	grep -Fxq 'hipblas_DIR:UNINITIALIZED=$(ROCM714_CMAKE_DIR)/hipblas' $(ROCM714_BUILD_DIR)/CMakeCache.txt || \
		grep -Fxq 'hipblas_DIR:PATH=$(ROCM714_CMAKE_DIR)/hipblas' $(ROCM714_BUILD_DIR)/CMakeCache.txt
	grep -Fxq 'rocblas_DIR:UNINITIALIZED=$(ROCM714_CMAKE_DIR)/rocblas' $(ROCM714_BUILD_DIR)/CMakeCache.txt || \
		grep -Fxq 'rocblas_DIR:PATH=$(ROCM714_CMAKE_DIR)/rocblas' $(ROCM714_BUILD_DIR)/CMakeCache.txt
	cmake --build $(ROCM714_BUILD_DIR) --target ggml-hip
	mkdir -p debian/$(ROCM714_PACKAGE)/$(ROCM714_BACKEND_DIR)
	cp -a $(ROCM714_BUILD_DIR)/bin/libggml-hip.so* \
		debian/$(ROCM714_PACKAGE)/$(ROCM714_BACKEND_DIR)/
	find debian/$(ROCM714_PACKAGE)/$(ROCM714_BACKEND_DIR) -maxdepth 1 \
		-type f -name 'libggml-hip.so*' \
		-exec patchelf --set-rpath '$$ORIGIN/../..:$(ROCM714_ROOT)/lib' {} +

	# Build the Intel SYCL backend independently with the oneAPI DPC++ compiler.
	# Keep compiler and library roots explicit instead of relying on a sourced
	# interactive setvars.sh environment.
	test -x $(ONEAPI_COMPILER_ROOT)/bin/icx
	test -x $(ONEAPI_COMPILER_ROOT)/bin/icpx
	test -x /usr/bin/g++
	test -f $(GNU_GCC_INSTALL_DIR)/crtbeginS.o
	test -f $(GNU_GCC_INSTALL_DIR)/libstdc++.so
	test -d $(ONEAPI_MKL_ROOT)
	test -d $(ONEAPI_DNNL_ROOT)
	test -d $(ONEAPI_TBB_ROOT)
	test -f $(ONEAPI_TBB_ROOT)/lib/cmake/tbb/TBBConfig.cmake
	$(ONEAPI_COMPILER_ROOT)/bin/icpx --version
	rm -rf $(SYCL_BUILD_DIR)
	mkdir -p $(SYCL_BUILD_DIR)
	# IntelLLVM can otherwise select an unrelated gcc-cross installation when
	# multiple Debian cross toolchains are installed.  Resolve the native GCC
	# installation through the default g++ driver and pin it exactly.
	printf '%s\n' '#include <iostream>' 'int main() { std::cout << "SYCL toolchain OK\\n"; }' \
		> $(SYCL_BUILD_DIR)/icpx-sycl-probe.cpp
	LD_LIBRARY_PATH=$(ONEAPI_LD_LIBRARY_PATH):$${LD_LIBRARY_PATH:-} \
		$(ONEAPI_COMPILER_ROOT)/bin/icpx -fsycl \
		--gcc-install-dir=$(GNU_GCC_INSTALL_DIR) \
		$(SYCL_BUILD_DIR)/icpx-sycl-probe.cpp \
		-o $(SYCL_BUILD_DIR)/icpx-sycl-probe
	LD_LIBRARY_PATH=$(ONEAPI_LD_LIBRARY_PATH):$${LD_LIBRARY_PATH:-} \
		$(SYCL_BUILD_DIR)/icpx-sycl-probe
	rm -f $(SYCL_BUILD_DIR)/icpx-sycl-probe.cpp $(SYCL_BUILD_DIR)/icpx-sycl-probe
	ONEAPI_ROOT=$(ONEAPI_ROOT) \
	MKLROOT=$(ONEAPI_MKL_ROOT) \
	DNNLROOT=$(ONEAPI_DNNL_ROOT) \
	TBBROOT=$(ONEAPI_TBB_ROOT) \
	CFLAGS=--gcc-install-dir=$(GNU_GCC_INSTALL_DIR) \
	CXXFLAGS=--gcc-install-dir=$(GNU_GCC_INSTALL_DIR) \
	CMAKE_PREFIX_PATH=$(ONEAPI_CMAKE_PREFIX_PATH) \
	PATH=$(ONEAPI_COMPILER_ROOT)/bin:$$PATH \
	LD_LIBRARY_PATH=$(ONEAPI_LD_LIBRARY_PATH):$${LD_LIBRARY_PATH:-} \
	cmake -S vendor/llama.cpp -B $(SYCL_BUILD_DIR) -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_COMPILER=$(ONEAPI_COMPILER_ROOT)/bin/icx \
		-DCMAKE_CXX_COMPILER=$(ONEAPI_COMPILER_ROOT)/bin/icpx \
		-DCMAKE_C_FLAGS=--gcc-install-dir=$(GNU_GCC_INSTALL_DIR) \
		-DCMAKE_CXX_FLAGS=--gcc-install-dir=$(GNU_GCC_INSTALL_DIR) \
		"-DCMAKE_PREFIX_PATH=$(ONEAPI_COMPILER_ROOT);$(ONEAPI_MKL_ROOT);$(ONEAPI_DNNL_ROOT);$(ONEAPI_TBB_ROOT)" \
		-DTBB_DIR=$(ONEAPI_TBB_ROOT)/lib/cmake/tbb \
		-DBUILD_SHARED_LIBS=ON \
		-DLLAMA_BUILD_COMMON=OFF \
		-DLLAMA_BUILD_TESTS=OFF \
		-DLLAMA_BUILD_TOOLS=OFF \
		-DLLAMA_BUILD_EXAMPLES=OFF \
		-DLLAMA_BUILD_SERVER=OFF \
		-DLLAMA_BUILD_APP=OFF \
		-DLLAMA_BUILD_UI=OFF \
		-DGGML_NATIVE=OFF \
		-DGGML_BACKEND_DL=ON \
		-DGGML_CPU=OFF \
		-DGGML_BLAS=OFF \
		-DGGML_SYCL=ON \
		-DGGML_SYCL_TARGET=INTEL \
		-DGGML_SYCL_F16=ON \
		-DGGML_SYCL_GRAPH=ON \
		-DGGML_SYCL_HOST_MEM_FALLBACK=ON \
		-DGGML_SYCL_SUPPORT_LEVEL_ZERO_API=ON \
		-DGGML_SYCL_DNN=ON \
		-DGGML_OPENMP=ON \
		-DGGML_BUILD_TESTS=OFF \
		-DGGML_BUILD_EXAMPLES=OFF
	grep -Fxq 'GGML_SYCL:BOOL=ON' $(SYCL_BUILD_DIR)/CMakeCache.txt
	grep -Fxq 'GGML_SYCL_TARGET:STRING=INTEL' $(SYCL_BUILD_DIR)/CMakeCache.txt
	ONEAPI_ROOT=$(ONEAPI_ROOT) \
	MKLROOT=$(ONEAPI_MKL_ROOT) \
	DNNLROOT=$(ONEAPI_DNNL_ROOT) \
	TBBROOT=$(ONEAPI_TBB_ROOT) \
	PATH=$(ONEAPI_COMPILER_ROOT)/bin:$$PATH \
	LD_LIBRARY_PATH=$(ONEAPI_LD_LIBRARY_PATH):$${LD_LIBRARY_PATH:-} \
	cmake --build $(SYCL_BUILD_DIR) --target ggml-sycl
	mkdir -p debian/$(SYCL_PACKAGE)/$(SYCL_BACKEND_DIR)
	cp -a $(SYCL_BUILD_DIR)/bin/libggml-sycl.so* \
		debian/$(SYCL_PACKAGE)/$(SYCL_BACKEND_DIR)/
	find debian/$(SYCL_PACKAGE)/$(SYCL_BACKEND_DIR) -maxdepth 1 \
		-type f -name 'libggml-sycl.so*' \
		-exec patchelf --set-rpath '$$ORIGIN/../..:$(ONEAPI_COMPILER_ROOT)/lib:$(ONEAPI_MKL_ROOT)/lib:$(ONEAPI_DNNL_ROOT)/lib:$(ONEAPI_TBB_ROOT)/lib' {} +

override_dh_python3:
	dh_python3 -p$(CORE_PACKAGE) --no-ext-rename

# libggml-base has a SONAME and is shared across our split backend packages,
# but it lives in a private Python package directory that dh_makeshlibs does
# not automatically describe. Provide exact in-tree shlibs metadata for it.
override_dh_makeshlibs:
	dh_makeshlibs -a
	install -d debian/$(CORE_PACKAGE)/DEBIAN
	{ \
		if [ -f debian/$(CORE_PACKAGE)/DEBIAN/shlibs ]; then \
			grep -v '^libggml-base[[:space:]]' debian/$(CORE_PACKAGE)/DEBIAN/shlibs || true; \
		fi; \
		printf '%s\n' 'libggml-base 0 $(CORE_PACKAGE) (= $(DEB_VERSION))'; \
	} > debian/$(CORE_PACKAGE)/DEBIAN/shlibs.tmp
	mv debian/$(CORE_PACKAGE)/DEBIAN/shlibs.tmp \
		debian/$(CORE_PACKAGE)/DEBIAN/shlibs

override_dh_shlibdeps:
	# Common libraries first.
	dh_shlibdeps -p$(CORE_PACKAGE) \
		-l/$(PYLIB_DIR)

	# Dynamic CPU backends link against libggml-base from the core package.
	dh_shlibdeps -p$(CPU_PACKAGE) \
		-L$(CORE_PACKAGE) \
		-l/$(PYLIB_DIR)

	# Vulkan backend links against the common ggml libraries from core and
	# against the system Vulkan loader.
	dh_shlibdeps -p$(VULKAN_PACKAGE) \
		-L$(CORE_PACKAGE) \
		-l/$(PYLIB_DIR)

	# CUDA backend links against libggml-base from core and the CUDA 12.4
	# runtime libraries from Debian.
	dh_shlibdeps -p$(CUDA124_PACKAGE) \
		-L$(CORE_PACKAGE) \
		-l/$(PYLIB_DIR):$(DEB_SYSTEM_LIBDIR) \
		-- -Ldebian/shlibs.cuda12

	# NVIDIA CUDA toolkits are installed side-by-side under /usr/local.
	# dh_shlibdeps accepts one -l option containing a colon-separated path list.
	# Keep the private llama_cpp library directory first so libggml-base is
	# resolved from the core package, then add the matching NVIDIA toolkit.
	dh_shlibdeps -p$(CUDA129_PACKAGE) \
		-L$(CORE_PACKAGE) \
		-l/$(PYLIB_DIR):$(CUDA129_ROOT)/targets/x86_64-linux/lib \
		-- -Ldebian/shlibs.cuda12 --ignore-missing-info

	dh_shlibdeps -p$(CUDA133_PACKAGE) \
		-L$(CORE_PACKAGE) \
		-l/$(PYLIB_DIR):$(CUDA133_ROOT)/targets/x86_64-linux/lib \
		-- -Ldebian/shlibs.cuda13 --ignore-missing-info

	# ROCm Core SDK 7.14 is an external versioned runtime under /opt.  Keep
	# explicit runtime/BLAS Depends in debian/control and still let shlibdeps
	# collect normal Debian dependencies.  AMD's external packages do not
	# consistently provide Debian shlibs/symbols metadata for every ROCm DSO.
	dh_shlibdeps -p$(ROCM714_PACKAGE) \
		-L$(CORE_PACKAGE) \
		-l/$(PYLIB_DIR):$(ROCM714_ROOT)/lib \
		-- --ignore-missing-info

	# Intel oneAPI libraries live under /opt and external oneAPI packages do not
	# consistently provide Debian shlibs/symbols metadata.  Runtime packages are
	# explicit in debian/control; still collect ordinary Debian dependencies
	# (including Level Zero) here.
	dh_shlibdeps -p$(SYCL_PACKAGE) \
		-L$(CORE_PACKAGE) \
		-l/$(PYLIB_DIR):$(ONEAPI_COMPILER_ROOT)/lib:$(ONEAPI_MKL_ROOT)/lib:$(ONEAPI_DNNL_ROOT)/lib:$(ONEAPI_TBB_ROOT)/lib \
		-- --ignore-missing-info

override_dh_missing:
	dh_missing --fail-missing
